<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <!-- Header info row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="Icon"
            android:src="@drawable/ic_dual_screen" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Thorientation"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_exp_header_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Preset: Landscape"
            android:textColor="#8E909D"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- SECTION 1: DUAL PRESETS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:letterSpacing="0.04"
            android:text="PRESETS (BOTH SCREENS)"
            android:textColor="#8E909D"
            android:textSize="9sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:orientation="horizontal"
            android:weightSum="4">

            <!-- Preset Port L (Left) -->
            <LinearLayout
                android:id="@+id/notif_exp_preset_portrait"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_notif_button"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">

                <ImageView
                    android:id="@+id/notif_exp_preset_iv_portrait"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="2dp"
                    android:contentDescription="Portrait L"
                    android:src="@drawable/ic_rotate_portrait" />

                <TextView
                    android:id="@+id/notif_exp_preset_tv_portrait"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Portrait L"
                    android:textColor="#D8D9E0"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Preset Land (Landscape) -->
            <LinearLayout
                android:id="@+id/notif_exp_preset_landscape"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_notif_button"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">

                <ImageView
                    android:id="@+id/notif_exp_preset_iv_landscape"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="2dp"
                    android:contentDescription="Landscape"
                    android:src="@drawable/ic_rotate_landscape" />

                <TextView
                    android:id="@+id/notif_exp_preset_tv_landscape"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Landscape"
                    android:textColor="#D8D9E0"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Preset Port R (Right) -->
            <LinearLayout
                android:id="@+id/notif_exp_preset_portrait_reverse"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_notif_button"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">

                <ImageView
                    android:id="@+id/notif_exp_preset_iv_portrait_reverse"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="2dp"
                    android:contentDescription="Portrait R"
                    android:src="@drawable/ic_rotate_rev_portrait" />

                <TextView
                    android:id="@+id/notif_exp_preset_tv_portrait_reverse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Portrait R"
                    android:textColor="#D8D9E0"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Preset Auto -->
            <LinearLayout
                android:id="@+id/notif_exp_preset_auto"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_notif_button"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">

                <ImageView
                    android:id="@+id/notif_exp_preset_iv_auto"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="2dp"
                    android:contentDescription="Auto"
                    android:src="@drawable/ic_rotate_auto" />

                <TextView
                    android:id="@+id/notif_exp_preset_tv_auto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Auto"
                    android:textColor="#D8D9E0"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- SECTION 2: TOP SCREEN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:letterSpacing="0.04"
            android:text="TOP SCREEN (PRIMARY)"
            android:textColor="#8E909D"
            android:textSize="9sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:orientation="horizontal"
            android:weightSum="4">

            <!-- Top Port L (Left) -->
            <LinearLayout
                android:id="@+id/notif_exp_top_portrait"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_notif_button"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">

                <ImageView
                    android:id="@+id/notif_exp_top_iv_portrait"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="2dp"
                    android:contentDescription="Portrait L"
                    android:src="@drawable/ic_rotate_portrait" />

                <TextView
                    android:id="@+id/notif_exp_top_tv_portrait"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Portrait L"
                    android:textColor="#D8D9E0"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Top Land (Landscape) -->
            <LinearLayout
                android:id="@+id/notif_exp_top_landscape"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_notif_button"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">

                <ImageView
                    android:id="@+id/notif_exp_top_iv_landscape"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="2dp"
                    android:contentDescription="Landscape"
                    android:src="@drawable/ic_rotate_landscape" />

                <TextView
                    android:id="@+id/notif_exp_top_tv_landscape"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Landscape"
                    android:textColor="#D8D9E0"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Top Port R (Right) -->
            <LinearLayout
                android:id="@+id/notif_exp_top_portrait_reverse"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_notif_button"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">

                <ImageView
                    android:id="@+id/notif_exp_top_iv_portrait_reverse"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="2dp"
                    android:contentDescription="Portrait R"
                    android:src="@drawable/ic_rotate_rev_portrait" />

                <TextView
                    android:id="@+id/notif_exp_top_tv_portrait_reverse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Portrait R"
                    android:textColor="#D8D9E0"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Top Auto -->
            <LinearLayout
                android:id="@+id/notif_exp_top_auto"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_notif_button"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">

                <ImageView
                    android:id="@+id/notif_exp_top_iv_auto"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="2dp"
                    android:contentDescription="Auto"
                    android:src="@drawable/ic_rotate_auto" />

                <TextView
                    android:id="@+id/notif_exp_top_tv_auto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Auto"
                    android:textColor="#D8D9E0"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- SECTION 3: BOTTOM SCREEN -->
    <LinearLayout
        android:id="@+id/notif_exp_bottom_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:letterSpacing="0.04"
            android:text="BOTTOM SCREEN"
            android:textColor="#8E909D"
            android:textSize="9sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:orientation="horizontal"
            android:weightSum="4">

            <!-- Bottom Port L (Left) -->
            <LinearLayout
                android:id="@+id/notif_exp_bottom_portrait"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_notif_button"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">

                <ImageView
                    android:id="@+id/notif_exp_bottom_iv_portrait"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="2dp"
                    android:contentDescription="Portrait L"
                    android:src="@drawable/ic_rotate_portrait" />

                <TextView
                    android:id="@+id/notif_exp_bottom_tv_portrait"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Portrait L"
                    android:textColor="#D8D9E0"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Bottom Land (Landscape) -->
            <LinearLayout
                android:id="@+id/notif_exp_bottom_landscape"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_notif_button"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">

                <ImageView
                    android:id="@+id/notif_exp_bottom_iv_landscape"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="2dp"
                    android:contentDescription="Landscape"
                    android:src="@drawable/ic_rotate_landscape" />

                <TextView
                    android:id="@+id/notif_exp_bottom_tv_landscape"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Landscape"
                    android:textColor="#D8D9E0"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Bottom Port R (Right) -->
            <LinearLayout
                android:id="@+id/notif_exp_bottom_portrait_reverse"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_notif_button"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">

                <ImageView
                    android:id="@+id/notif_exp_bottom_iv_portrait_reverse"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="2dp"
                    android:contentDescription="Portrait R"
                    android:src="@drawable/ic_rotate_rev_portrait" />

                <TextView
                    android:id="@+id/notif_exp_bottom_tv_portrait_reverse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Portrait R"
                    android:textColor="#D8D9E0"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Bottom Auto -->
            <LinearLayout
                android:id="@+id/notif_exp_bottom_auto"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_notif_button"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">

                <ImageView
                    android:id="@+id/notif_exp_bottom_iv_auto"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="2dp"
                    android:contentDescription="Auto"
                    android:src="@drawable/ic_rotate_auto" />

                <TextView
                    android:id="@+id/notif_exp_bottom_tv_auto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Auto"
                    android:textColor="#D8D9E0"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
